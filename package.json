{
  "name": "issue-runner",
  "version": "0.1.1",
  "description": "Ticket-driven coding-agent orchestration for configured GitHub projects.",
  "keywords": [
    "coding-agent",
    "agent-orchestration",
    "ai-agent",
    "github",
    "github-issues",
    "issue-automation",
    "pull-request",
    "workflow-automation",
    "cli",
    "sandcastle",
    "issue-runner"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "issue-runner": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuddyLabsCo/sandcastle-runner.git"
  },
  "homepage": "https://github.com/BuddyLabsCo/sandcastle-runner#readme",
  "bugs": {
    "url": "https://github.com/BuddyLabsCo/sandcastle-runner/issues"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "prepack": "npm run build",
    "release:accept": "node scripts/package-acceptance.ts",
    "test": "node --test --test-timeout=240000 \"tests/**/*.test.ts\"",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" --no-error-on-unmatched-pattern",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "npm test && npm run check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "cac": "7.0.0",
    "cross-spawn": "7.0.6",
    "yaml": "2.9.1"
  }
}
